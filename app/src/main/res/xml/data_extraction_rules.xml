<?xml version="1.0" encoding="utf-8"?>
<data-extraction-rules xmlns:tools="http://schemas.android.com/tools">
    <cloud-backup>
        <exclude
            domain="sharedpref"
            path="crash.xml" />
        <exclude
            domain="file"
            path="error"
            tools:ignore="FullBackupContent" />
        <!-- 账号 BDUSS/stoken 与浏览记录都在数据库和 DataStore 里，禁止随云备份外带 -->
        <exclude
            domain="database"
            path="." />
        <exclude
            domain="file"
            path="datastore" />
        <exclude
            domain="file"
            path="." />
    </cloud-backup>
    <device-transfer>
        <exclude
            domain="sharedpref"
            path="crash.xml" />
        <exclude
            domain="file"
            path="error"
            tools:ignore="FullBackupContent" />
        <exclude
            domain="database"
            path="." />
        <exclude
            domain="file"
            path="datastore" />
        <exclude
            domain="file"
            path="." />
    </device-transfer>
</data-extraction-rules>
